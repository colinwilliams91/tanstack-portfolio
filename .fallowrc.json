{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    // TanStack Start server entry — exports startInstance via createStart().
    // The tanstack-router plugin discovers route files and src/router.tsx
    // on its own, but the server entry is convention-only and needs to be
    // declared so it stays reachable now that src/routeTree.gen.ts is
    // excluded from analysis.
    "src/start.ts"
  ],
  "ignorePatterns": [
    // Generated by TanStack Router's codegen. The bidirectional wiring
    // between this file, route files, and src/router.tsx is by design and
    // creates 3 structural cycles that aren't real init-order hazards. The
    // tanstack-router plugin still injects each route file as an entry
    // point independently, so excluding the generated file keeps the graph
    // analysis intact.
    "src/routeTree.gen.ts"
  ],
  "ignoreDependencies": [
    // tsconfig path alias for `src/assets/*` — resolves only to non-TS asset
    // files (.webp, etc.) so fallow's module graph treats the prefix as an
    // external package. Not a real dependency.
    "~a"
  ],
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  "rules": {}
}
